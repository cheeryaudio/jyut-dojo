[
  { "id": "r1", "scenarioId": "rent", "speaker": "A", "hanzi": "我想租一個單位。", "jyutping": "ngo5 soeng2 zou1 jat1 go3 daan1 wai2", "mandarin": "我想租一套公寓。", "audio": "/audio/sentences/r1.mp3", "vocab": ["zou1", "daan1wai2"] },
  { "id": "r2", "scenarioId": "rent", "speaker": "B", "hanzi": "你想搵邊區㗎？", "jyutping": "nei5 soeng2 wan2 bin1 keoi1 gaa3", "mandarin": "你想找哪个区？", "audio": "/audio/sentences/r2.mp3", "vocab": ["wan2", "keoi1"] },
  { "id": "r3", "scenarioId": "rent", "speaker": "A", "hanzi": "最好近地鐵站啦。", "jyutping": "zeoi3 hou2 kan5 dei6 tit3 zaam6 laa1", "mandarin": "最好靠近地铁站。", "audio": "/audio/sentences/r3.mp3", "vocab": ["kan5", "dei6tit3zaam6"] },
  { "id": "r4", "scenarioId": "rent", "speaker": "B", "hanzi": "呢個單位一房一廳。", "jyutping": "ni1 go3 daan1 wai2 jat1 fong4 jat1 teng1", "mandarin": "这个单元一房一厅。", "audio": "/audio/sentences/r4.mp3", "vocab": ["daan1wai2", "fong4", "teng1"] },
  { "id": "r5", "scenarioId": "rent", "speaker": "A", "hanzi": "租金幾多錢一個月呀？", "jyutping": "zou1 gam1 gei2 do1 cin2 jat1 go3 jyut6 aa3", "mandarin": "租金一个月多少钱？", "audio": "/audio/sentences/r5.mp3", "vocab": ["zou1gam1", "gei2do1", "cin2"] },
  { "id": "r6", "scenarioId": "rent", "speaker": "B", "hanzi": "一萬二，包管理費。", "jyutping": "jat1 maan6 ji6 baau1 gun2 lei5 fai3", "mandarin": "一万二，包含管理费。", "audio": "/audio/sentences/r6.mp3", "vocab": ["baau1", "gun2lei5fai3"] },
  { "id": "r7", "scenarioId": "rent", "speaker": "A", "hanzi": "可唔可以睇下屋呀？", "jyutping": "ho2 m4 ho2 ji5 tai2 haa5 uk1 aa3", "mandarin": "可不可以看一下房子？", "audio": "/audio/sentences/r7.mp3", "vocab": ["tai2uk1"] },
  { "id": "r8", "scenarioId": "rent", "speaker": "B", "hanzi": "得，聽日帶你去睇。", "jyutping": "dak1 ting1 jat6 daai3 nei5 heoi3 tai2", "mandarin": "行，明天带你去看。", "audio": "/audio/sentences/r8.mp3", "vocab": ["dak1", "ting1jat6", "daai3"] },

  { "id": "o1", "scenarioId": "work", "speaker": "A", "hanzi": "早晨，今日開會呀？", "jyutping": "zou2 san4 gam1 jat6 hoi1 wui2 aa3", "mandarin": "早上好，今天开会吗？", "audio": "/audio/sentences/o1.mp3", "vocab": ["zou2san4", "hoi1wui2"] },
  { "id": "o2", "scenarioId": "work", "speaker": "B", "hanzi": "係呀，十點喺會議室。", "jyutping": "hai6 aa3 sap6 dim2 hai2 wui6 ji5 sat1", "mandarin": "是的，十点在会议室。", "audio": "/audio/sentences/o2.mp3", "vocab": ["wui6ji5sat1"] },
  { "id": "o3", "scenarioId": "work", "speaker": "A", "hanzi": "份報告我做好咗喇。", "jyutping": "fan6 bou3 gou3 ngo5 zou6 hou2 zo2 laa3", "mandarin": "那份报告我做好了。", "audio": "/audio/sentences/o3.mp3", "vocab": ["bou3gou3", "zou6"] },
  { "id": "o4", "scenarioId": "work", "speaker": "B", "hanzi": "做得好！辛苦晒。", "jyutping": "zou6 dak1 hou2 san1 fu2 saai3", "mandarin": "做得好！辛苦了。", "audio": "/audio/sentences/o4.mp3", "vocab": ["zou6", "san1fu2"] },
  { "id": "o5", "scenarioId": "work", "speaker": "A", "hanzi": "呢單嘢幾時要交呀？", "jyutping": "ni1 daan1 je5 gei2 si4 jiu3 gaau1 aa3", "mandarin": "这个任务什么时候要交？", "audio": "/audio/sentences/o5.mp3", "vocab": ["je5", "gei2si4", "gaau1"] },
  { "id": "o6", "scenarioId": "work", "speaker": "B", "hanzi": "下星期五之前。", "jyutping": "haa6 sing1 kei4 ng5 zi1 cin4", "mandarin": "下周五之前。", "audio": "/audio/sentences/o6.mp3", "vocab": ["zi1cin4"] },
  { "id": "o7", "scenarioId": "work", "speaker": "A", "hanzi": "得，我哋加油啦。", "jyutping": "dak1 ngo5 dei6 gaa1 jau4 laa1", "mandarin": "行，我们加油吧。", "audio": "/audio/sentences/o7.mp3", "vocab": ["gaa1jau4"] },
  { "id": "o8", "scenarioId": "work", "speaker": "B", "hanzi": "放工一齊食飯吖？", "jyutping": "fong3 gung1 jat1 cai4 sik6 faan6 aa1", "mandarin": "下班一起吃饭呗？", "audio": "/audio/sentences/o8.mp3", "vocab": ["fong3gung1", "jat1cai4"] },

  { "id": "u1", "scenarioId": "dimsum", "speaker": "A", "hanzi": "我哋去飲茶好唔好？", "jyutping": "ngo5 dei6 heoi3 jam2 caa4 hou2 m4 hou2", "mandarin": "我们去喝早茶好不好？", "audio": "/audio/sentences/u1.mp3", "vocab": ["jam2caa4"] },
  { "id": "u2", "scenarioId": "dimsum", "speaker": "B", "hanzi": "好呀，我最鍾意食點心。", "jyutping": "hou2 aa3 ngo5 zeoi3 zung1 ji3 sik6 dim2 sam1", "mandarin": "好啊，我最喜欢吃点心。", "audio": "/audio/sentences/u2.mp3", "vocab": ["zung1ji3", "dim2sam1"] },
  { "id": "u3", "scenarioId": "dimsum", "speaker": "A", "hanzi": "唔該，要一籠蝦餃。", "jyutping": "m4 goi1 jiu3 jat1 lung4 haa1 gaau2", "mandarin": "服务员，要一笼虾饺。", "audio": "/audio/sentences/u3.mp3", "vocab": ["lung4", "haa1gaau2"] },
  { "id": "u4", "scenarioId": "dimsum", "speaker": "A", "hanzi": "仲要燒賣同叉燒包。", "jyutping": "zung6 jiu3 siu1 maai2 tung4 caa1 siu1 baau1", "mandarin": "还要烧卖和叉烧包。", "audio": "/audio/sentences/u4.mp3", "vocab": ["siu1maai2", "caa1siu1baau1"] },
  { "id": "u5", "scenarioId": "dimsum", "speaker": "B", "hanzi": "飲咩茶呀？普洱得唔得？", "jyutping": "jam2 me1 caa4 aa3 pou2 lei2 dak1 m4 dak1", "mandarin": "喝什么茶？普洱行不行？", "audio": "/audio/sentences/u5.mp3", "vocab": ["pou2lei2", "dak1"] },
  { "id": "u6", "scenarioId": "dimsum", "speaker": "A", "hanzi": "得呀，唔該加啲熱水。", "jyutping": "dak1 aa3 m4 goi1 gaa1 di1 jit6 seoi2", "mandarin": "行啊，麻烦加点热水。", "audio": "/audio/sentences/u6.mp3", "vocab": ["jit6seoi2"] },
  { "id": "u7", "scenarioId": "dimsum", "speaker": "B", "hanzi": "啲蝦餃真係好好食。", "jyutping": "di1 haa1 gaau2 zan1 hai6 hou2 hou2 sik6", "mandarin": "这虾饺真的很好吃。", "audio": "/audio/sentences/u7.mp3", "vocab": ["haa1gaau2"] },
  { "id": "u8", "scenarioId": "dimsum", "speaker": "A", "hanzi": "食飽喇，埋單啦。", "jyutping": "sik6 baau2 laa3 maai4 daan1 laa1", "mandarin": "吃饱了，买单吧。", "audio": "/audio/sentences/u8.mp3", "vocab": ["baau2", "maai4daan1"] },

  { "id": "f1", "scenarioId": "pharmacy", "speaker": "A", "hanzi": "唔該，有冇感冒藥呀？", "jyutping": "m4 goi1 jau5 mou5 gam2 mou6 joek6 aa3", "mandarin": "请问有没有感冒药？", "audio": "/audio/sentences/f1.mp3", "vocab": ["jau5mou5", "gam2mou6", "joek6"] },
  { "id": "f2", "scenarioId": "pharmacy", "speaker": "B", "hanzi": "有，你咩症狀呀？", "jyutping": "jau5 nei5 me1 zing3 zong6 aa3", "mandarin": "有，你什么症状？", "audio": "/audio/sentences/f2.mp3", "vocab": ["zing3zong6"] },
  { "id": "f3", "scenarioId": "pharmacy", "speaker": "A", "hanzi": "流鼻水，仲咳添。", "jyutping": "lau4 bei6 seoi2 zung6 kat1 tim1", "mandarin": "流鼻涕，还咳嗽。", "audio": "/audio/sentences/f3.mp3", "vocab": ["lau4bei6seoi2", "kat1", "tim1"] },
  { "id": "f4", "scenarioId": "pharmacy", "speaker": "B", "hanzi": "呢隻藥好有效。", "jyutping": "ni1 zek3 joek6 hou2 jau5 haau6", "mandarin": "这种药很有效。", "audio": "/audio/sentences/f4.mp3", "vocab": ["zek3", "jau5haau6"] },
  { "id": "f5", "scenarioId": "pharmacy", "speaker": "A", "hanzi": "一日食幾多次呀？", "jyutping": "jat1 jat6 sik6 gei2 do1 ci3 aa3", "mandarin": "一天吃几次？", "audio": "/audio/sentences/f5.mp3", "vocab": ["gei2do1", "ci3"] },
  { "id": "f6", "scenarioId": "pharmacy", "speaker": "B", "hanzi": "早晚各一次，飯後食。", "jyutping": "zou2 maan5 gok3 jat1 ci3 faan6 hau6 sik6", "mandarin": "早晚各一次，饭后吃。", "audio": "/audio/sentences/f6.mp3", "vocab": ["gok3", "faan6hau6"] },
  { "id": "f7", "scenarioId": "pharmacy", "speaker": "A", "hanzi": "幾多錢呀？", "jyutping": "gei2 do1 cin2 aa3", "mandarin": "多少钱？", "audio": "/audio/sentences/f7.mp3", "vocab": ["gei2do1", "cin2"] },
  { "id": "f8", "scenarioId": "pharmacy", "speaker": "B", "hanzi": "五十八蚊。祝你早日康復！", "jyutping": "ng5 sap6 baat3 man1 zuk1 nei5 zou2 jat6 hong1 fuk6", "mandarin": "五十八块。祝你早日康复！", "audio": "/audio/sentences/f8.mp3", "vocab": ["man1", "zuk1", "hong1fuk6"] },

  { "id": "b1", "scenarioId": "bank", "speaker": "A", "hanzi": "唔該，我想唱啲錢。", "jyutping": "m4 goi1 ngo5 soeng2 coeng3 di1 cin2", "mandarin": "麻烦你，我想换点钱。", "audio": "/audio/sentences/b1.mp3", "vocab": ["coeng3cin2"] },
  { "id": "b2", "scenarioId": "bank", "speaker": "B", "hanzi": "唱咩貨幣呀？", "jyutping": "coeng3 me1 fo3 bai6 aa3", "mandarin": "换什么货币？", "audio": "/audio/sentences/b2.mp3", "vocab": ["coeng3cin2", "fo3bai6"] },
  { "id": "b3", "scenarioId": "bank", "speaker": "A", "hanzi": "人民幣唱港紙。", "jyutping": "jan4 man4 bai6 coeng3 gong2 zi2", "mandarin": "人民币换港币。", "audio": "/audio/sentences/b3.mp3", "vocab": ["jan4man4bai6", "gong2zi2"] },
  { "id": "b4", "scenarioId": "bank", "speaker": "B", "hanzi": "今日匯率幾好。", "jyutping": "gam1 jat6 wui6 leot6 gei2 hou2", "mandarin": "今天汇率挺好。", "audio": "/audio/sentences/b4.mp3", "vocab": ["wui6leot2"] },
  { "id": "b5", "scenarioId": "bank", "speaker": "A", "hanzi": "我想唱三千蚊。", "jyutping": "ngo5 soeng2 coeng3 saam1 cin1 man1", "mandarin": "我想换三千块。", "audio": "/audio/sentences/b5.mp3", "vocab": ["coeng3cin2", "man1"] },
  { "id": "b6", "scenarioId": "bank", "speaker": "B", "hanzi": "唔該畀身份證我。", "jyutping": "m4 goi1 bei2 san1 fan2 zing3 ngo5", "mandarin": "麻烦给我身份证。", "audio": "/audio/sentences/b6.mp3", "vocab": ["bei2", "san1fan2zing3"] },
  { "id": "b7", "scenarioId": "bank", "speaker": "B", "hanzi": "呢度係你嘅錢，點清佢。", "jyutping": "ni1 dou6 hai6 nei5 ge3 cin2 dim2 cing1 keoi5", "mandarin": "这是你的钱，点清楚。", "audio": "/audio/sentences/b7.mp3", "vocab": ["cin2", "dim2cing1"] },
  { "id": "b8", "scenarioId": "bank", "speaker": "A", "hanzi": "啱數，唔該晒。", "jyutping": "ngaam1 sou3 m4 goi1 saai3", "mandarin": "数目对，多谢了。", "audio": "/audio/sentences/b8.mp3", "vocab": ["ngaam1sou3", "m4goi1saai3"] },

  { "id": "n1", "scenarioId": "cny", "speaker": "A", "hanzi": "恭喜發財！", "jyutping": "gung1 hei2 faat3 coi4", "mandarin": "恭喜发财！", "audio": "/audio/sentences/n1.mp3", "vocab": ["gung1hei2faat3coi4"] },
  { "id": "n2", "scenarioId": "cny", "speaker": "B", "hanzi": "新年快樂，身體健康！", "jyutping": "san1 nin4 faai3 lok6 san1 tai2 gin6 hong1", "mandarin": "新年快乐，身体健康！", "audio": "/audio/sentences/n2.mp3", "vocab": ["san1nin4faai3lok6", "san1tai2gin6hong1"] },
  { "id": "n3", "scenarioId": "cny", "speaker": "A", "hanzi": "逗利是喇！", "jyutping": "dau6 lai6 si6 laa3", "mandarin": "讨红包啦！", "audio": "/audio/sentences/n3.mp3", "vocab": ["dau6", "lai6si6"] },
  { "id": "n4", "scenarioId": "cny", "speaker": "B", "hanzi": "好啦好啦，畀封利是你。", "jyutping": "hou2 laa1 hou2 laa1 bei2 fung1 lai6 si6 nei5", "mandarin": "好啦好啦，给你一个红包。", "audio": "/audio/sentences/n4.mp3", "vocab": ["bei2", "fung1", "lai6si6"] },
  { "id": "n5", "scenarioId": "cny", "speaker": "A", "hanzi": "今晚返屋企食團年飯。", "jyutping": "gam1 maan5 faan1 uk1 kei2 sik6 tyun4 nin4 faan6", "mandarin": "今晚回家吃团年饭。", "audio": "/audio/sentences/n5.mp3", "vocab": ["gam1maan5", "uk1kei2", "tyun4nin4faan6"] },
  { "id": "n6", "scenarioId": "cny", "speaker": "B", "hanzi": "我哋仲要去行花市。", "jyutping": "ngo5 dei6 zung6 jiu3 heoi3 haang4 faa1 si5", "mandarin": "我们还要去逛花市。", "audio": "/audio/sentences/n6.mp3", "vocab": ["haang4faa1si5"] },
  { "id": "n7", "scenarioId": "cny", "speaker": "A", "hanzi": "祝你今年心想事成！", "jyutping": "zuk1 nei5 gam1 nin2 sam1 soeng2 si6 sing4", "mandarin": "祝你今年心想事成！", "audio": "/audio/sentences/n7.mp3", "vocab": ["zuk1", "sam1soeng2si6sing4"] },
  { "id": "n8", "scenarioId": "cny", "speaker": "B", "hanzi": "大家咁話！", "jyutping": "daai6 gaa1 gam2 waa6", "mandarin": "彼此彼此！（新年经典回礼）", "audio": "/audio/sentences/n8.mp3", "vocab": ["daai6gaa1gam2waa6"] }
