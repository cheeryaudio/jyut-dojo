[
  { "id": "k1", "scenarioId": "market", "speaker": "A", "hanzi": "老闆，啲菜心點賣呀？", "jyutping": "lou5 baan2 di1 coi3 sam1 dim2 maai6 aa3", "mandarin": "老板，菜心怎么卖？", "audio": "/audio/sentences/k1.mp3", "vocab": ["lou5baan2", "coi3sam1", "dim2maai6"] },
  { "id": "k2", "scenarioId": "market", "speaker": "B", "hanzi": "十蚊兩斤。", "jyutping": "sap6 man1 loeng5 gan1", "mandarin": "十块两斤。", "audio": "/audio/sentences/k2.mp3", "vocab": ["man1", "loeng5", "gan1"] },
  { "id": "k3", "scenarioId": "market", "speaker": "A", "hanzi": "畀一斤我啦。", "jyutping": "bei2 jat1 gan1 ngo5 laa1", "mandarin": "给我来一斤吧。", "audio": "/audio/sentences/k3.mp3", "vocab": ["bei2", "gan1"] },
  { "id": "k4", "scenarioId": "market", "speaker": "A", "hanzi": "呢啲魚新唔新鮮㗎？", "jyutping": "ni1 di1 jyu2 san1 m4 san1 sin1 gaa3", "mandarin": "这些鱼新不新鲜？", "audio": "/audio/sentences/k4.mp3", "vocab": ["jyu2", "san1sin1"] },
  { "id": "k5", "scenarioId": "market", "speaker": "B", "hanzi": "朝早先返嘅，好新鮮。", "jyutping": "ziu1 zou2 sin1 faan1 ge3 hou2 san1 sin1", "mandarin": "今天早上刚到的，很新鲜。", "audio": "/audio/sentences/k5.mp3", "vocab": ["ziu1zou2", "faan1", "san1sin1"] },
  { "id": "k6", "scenarioId": "market", "speaker": "B", "hanzi": "仲要唔要第二啲嘢呀？", "jyutping": "zung6 jiu3 m4 jiu3 dai6 ji6 di1 je5 aa3", "mandarin": "还要不要别的东西？", "audio": "/audio/sentences/k6.mp3", "vocab": ["zung6", "jiu3", "je5"] },
  { "id": "k7", "scenarioId": "market", "speaker": "A", "hanzi": "唔使喇，一共幾多錢呀？", "jyutping": "m4 sai2 laa3 jat1 gung6 gei2 do1 cin2 aa3", "mandarin": "不用了，一共多少钱？", "audio": "/audio/sentences/k7.mp3", "vocab": ["m4sai2", "jat1gung6", "gei2do1", "cin2"] },
  { "id": "k8", "scenarioId": "market", "speaker": "B", "hanzi": "收你二十蚊，唔該。", "jyutping": "sau1 nei5 ji6 sap6 man1 m4 goi1", "mandarin": "收你二十块，谢谢。", "audio": "/audio/sentences/k8.mp3", "vocab": ["sau1", "man1"] },

  { "id": "y1", "scenarioId": "doctor", "speaker": "A", "hanzi": "醫生，我唔舒服。", "jyutping": "ji1 sang1 ngo5 m4 syu1 fuk6", "mandarin": "医生，我不舒服。", "audio": "/audio/sentences/y1.mp3", "vocab": ["ji1sang1", "syu1fuk6"] },
  { "id": "y2", "scenarioId": "doctor", "speaker": "B", "hanzi": "你邊度唔舒服呀？", "jyutping": "nei5 bin1 dou6 m4 syu1 fuk6 aa3", "mandarin": "你哪里不舒服？", "audio": "/audio/sentences/y2.mp3", "vocab": ["bin1dou6", "syu1fuk6"] },
  { "id": "y3", "scenarioId": "doctor", "speaker": "A", "hanzi": "我頭痛，仲有啲發燒。", "jyutping": "ngo5 tau4 tung3 zung6 jau5 di1 faat3 siu1", "mandarin": "我头痛，还有点发烧。", "audio": "/audio/sentences/y3.mp3", "vocab": ["tau4tung3", "zung6", "faat3siu1"] },
  { "id": "y4", "scenarioId": "doctor", "speaker": "B", "hanzi": "幾時開始㗎？", "jyutping": "gei2 si4 hoi1 ci2 gaa3", "mandarin": "什么时候开始的？", "audio": "/audio/sentences/y4.mp3", "vocab": ["gei2si4", "hoi1ci2"] },
  { "id": "y5", "scenarioId": "doctor", "speaker": "A", "hanzi": "尋日夜晚開始。", "jyutping": "cam4 jat6 je6 maan5 hoi1 ci2", "mandarin": "昨天晚上开始的。", "audio": "/audio/sentences/y5.mp3", "vocab": ["cam4jat6", "je6maan5", "hoi1ci2"] },
  { "id": "y6", "scenarioId": "doctor", "speaker": "B", "hanzi": "你係感冒啫，唔使擔心。", "jyutping": "nei5 hai6 gam2 mou6 ze1 m4 sai2 daam1 sam1", "mandarin": "你只是感冒，不用担心。", "audio": "/audio/sentences/y6.mp3", "vocab": ["gam2mou6", "m4sai2", "daam1sam1"] },
  { "id": "y7", "scenarioId": "doctor", "speaker": "B", "hanzi": "呢啲藥一日食三次。", "jyutping": "ni1 di1 joek6 jat1 jat6 sik6 saam1 ci3", "mandarin": "这些药一天吃三次。", "audio": "/audio/sentences/y7.mp3", "vocab": ["joek6", "sik6", "ci3"] },
  { "id": "y8", "scenarioId": "doctor", "speaker": "A", "hanzi": "多謝醫生，拜拜。", "jyutping": "do1 ze6 ji1 sang1 baai1 baai3", "mandarin": "谢谢医生，拜拜。", "audio": "/audio/sentences/y8.mp3", "vocab": ["do1ze6", "ji1sang1", "baai1baai3"] },

  { "id": "t1", "scenarioId": "taxi", "speaker": "A", "hanzi": "司機，唔該去機場。", "jyutping": "si1 gei1 m4 goi1 heoi3 gei1 coeng4", "mandarin": "师傅，麻烦去机场。", "audio": "/audio/sentences/t1.mp3", "vocab": ["si1gei1", "heoi3", "gei1coeng4"] },
  { "id": "t2", "scenarioId": "taxi", "speaker": "B", "hanzi": "好呀，上車啦。", "jyutping": "hou2 aa3 soeng5 ce1 laa1", "mandarin": "好的，上车吧。", "audio": "/audio/sentences/t2.mp3", "vocab": ["soeng5ce1"] },
  { "id": "t3", "scenarioId": "taxi", "speaker": "A", "hanzi": "大概要幾耐呀？", "jyutping": "daai6 koi3 jiu3 gei2 noi6 aa3", "mandarin": "大概要多久？", "audio": "/audio/sentences/t3.mp3", "vocab": ["daai6koi3", "gei2noi6"] },
  { "id": "t4", "scenarioId": "taxi", "speaker": "B", "hanzi": "唔塞車嘅話，半個鐘啦。", "jyutping": "m4 sak1 ce1 ge3 waa2 bun3 go3 zung1 laa1", "mandarin": "不堵车的话，半小时吧。", "audio": "/audio/sentences/t4.mp3", "vocab": ["sak1ce1", "bun3go3zung1"] },
  { "id": "t5", "scenarioId": "taxi", "speaker": "A", "hanzi": "唔該快啲，我趕時間。", "jyutping": "m4 goi1 faai3 di1 ngo5 gon2 si4 gaan3", "mandarin": "麻烦快点，我赶时间。", "audio": "/audio/sentences/t5.mp3", "vocab": ["faai3di1", "gon2si4gaan3"] },
  { "id": "t6", "scenarioId": "taxi", "speaker": "A", "hanzi": "前面轉右就到喇。", "jyutping": "cin4 min6 zyun3 jau6 zau6 dou3 laa3", "mandarin": "前面右转就到了。", "audio": "/audio/sentences/t6.mp3", "vocab": ["zyun3jau6"] },
  { "id": "t7", "scenarioId": "taxi", "speaker": "A", "hanzi": "喺呢度停就得喇。", "jyutping": "hai2 ni1 dou6 ting4 zau6 dak1 laa3", "mandarin": "在这里停就行了。", "audio": "/audio/sentences/t7.mp3", "vocab": ["hai2", "ting4", "dak1"] },
  { "id": "t8", "scenarioId": "taxi", "speaker": "B", "hanzi": "車費八十蚊。", "jyutping": "ce1 fai3 baat3 sap6 man1", "mandarin": "车费八十块。", "audio": "/audio/sentences/t8.mp3", "vocab": ["ce1fai3", "man1"] },

  { "id": "h1", "scenarioId": "hangout", "speaker": "A", "hanzi": "週末有冇節目呀？", "jyutping": "zau1 mut6 jau5 mou5 zit3 muk6 aa3", "mandarin": "周末有没有安排？", "audio": "/audio/sentences/h1.mp3", "vocab": ["zau1mut6", "jau5mou5", "zit3muk6"] },
  { "id": "h2", "scenarioId": "hangout", "speaker": "B", "hanzi": "冇呀，喺屋企休息。", "jyutping": "mou5 aa3 hai2 uk1 kei2 jau1 sik1", "mandarin": "没有，在家休息。", "audio": "/audio/sentences/h2.mp3", "vocab": ["mou5", "uk1kei2", "jau1sik1"] },
  { "id": "h3", "scenarioId": "hangout", "speaker": "A", "hanzi": "不如一齊去睇戲吖？", "jyutping": "bat1 jyu4 jat1 cai4 heoi3 tai2 hei3 aa1", "mandarin": "不如一起去看电影？", "audio": "/audio/sentences/h3.mp3", "vocab": ["bat1jyu4", "jat1cai4", "tai2hei3"] },
  { "id": "h4", "scenarioId": "hangout", "speaker": "B", "hanzi": "好主意！睇邊套戲好呢？", "jyutping": "hou2 zyu2 ji3 tai2 bin1 tou3 hei3 hou2 ne1", "mandarin": "好主意！看哪部电影好呢？", "audio": "/audio/sentences/h4.mp3", "vocab": ["zyu2ji3", "tai2hei3"] },
  { "id": "h5", "scenarioId": "hangout", "speaker": "A", "hanzi": "聽講嗰套新戲幾好睇。", "jyutping": "teng1 gong2 go2 tou3 san1 hei3 gei2 hou2 tai2", "mandarin": "听说那部新片挺好看的。", "audio": "/audio/sentences/h5.mp3", "vocab": ["teng1gong2"] },
  { "id": "h6", "scenarioId": "hangout", "speaker": "B", "hanzi": "咁我哋幾點集合呀？", "jyutping": "gam2 ngo5 dei6 gei2 dim2 zaap6 hap6 aa3", "mandarin": "那我们几点集合？", "audio": "/audio/sentences/h6.mp3", "vocab": ["ngo5dei6", "gei2dim2", "zaap6hap6"] },
  { "id": "h7", "scenarioId": "hangout", "speaker": "A", "hanzi": "七點喺戲院門口等。", "jyutping": "cat1 dim2 hai2 hei3 jyun2 mun4 hau2 dang2", "mandarin": "七点在电影院门口等。", "audio": "/audio/sentences/h7.mp3", "vocab": ["hei3jyun2", "mun4hau2", "dang2"] },
  { "id": "h8", "scenarioId": "hangout", "speaker": "B", "hanzi": "好，唔見唔散！", "jyutping": "hou2 m4 gin3 m4 saan3", "mandarin": "好，不见不散！", "audio": "/audio/sentences/h8.mp3", "vocab": ["m4gin3m4saan3"] },

  { "id": "j1", "scenarioId": "home", "speaker": "A", "hanzi": "我返嚟喇！", "jyutping": "ngo5 faan1 lai4 laa3", "mandarin": "我回来了！", "audio": "/audio/sentences/j1.mp3", "vocab": ["faan1lai4"] },
  { "id": "j2", "scenarioId": "home", "speaker": "B", "hanzi": "整咗你最鍾意嘅餸。", "jyutping": "zing2 zo2 nei5 zeoi3 zung1 ji3 ge3 sung3", "mandarin": "做了你最喜欢的菜。", "audio": "/audio/sentences/j2.mp3", "vocab": ["zing2", "zung1ji3", "sung3"] },
  { "id": "j3", "scenarioId": "home", "speaker": "A", "hanzi": "好香呀！煮咗啲咩呀？", "jyutping": "hou2 hoeng1 aa3 zyu2 zo2 di1 me1 aa3", "mandarin": "好香啊！煮了什么？", "audio": "/audio/sentences/j3.mp3", "vocab": ["zyu2", "me1"] },
  { "id": "j4", "scenarioId": "home", "speaker": "B", "hanzi": "蒸魚同埋炒菜。", "jyutping": "zing1 jyu2 tung4 maai4 caau2 coi3", "mandarin": "蒸鱼还有炒菜。", "audio": "/audio/sentences/j4.mp3", "vocab": ["zing1jyu2", "tung4maai4", "caau2coi3"] },
  { "id": "j5", "scenarioId": "home", "speaker": "B", "hanzi": "快啲洗手食飯啦。", "jyutping": "faai3 di1 sai2 sau2 sik6 faan6 laa1", "mandarin": "快点洗手吃饭吧。", "audio": "/audio/sentences/j5.mp3", "vocab": ["faai3di1", "sai2sau2", "sik6", "faan6"] },
  { "id": "j6", "scenarioId": "home", "speaker": "B", "hanzi": "今日返工辛唔辛苦呀？", "jyutping": "gam1 jat6 faan1 gung1 san1 m4 san1 fu2 aa3", "mandarin": "今天上班辛不辛苦？", "audio": "/audio/sentences/j6.mp3", "vocab": ["faan1gung1", "san1fu2"] },
  { "id": "j7", "scenarioId": "home", "speaker": "A", "hanzi": "都幾忙，不過冇問題。", "jyutping": "dou1 gei2 mong4 bat1 gwo3 mou5 man6 tai4", "mandarin": "挺忙的，不过没问题。", "audio": "/audio/sentences/j7.mp3", "vocab": ["bat1gwo3", "man6tai4"] },
  { "id": "j8", "scenarioId": "home", "speaker": "B", "hanzi": "辛苦晒喇，早啲休息啦。", "jyutping": "san1 fu2 saai3 laa3 zou2 di1 jau1 sik1 laa1", "mandarin": "辛苦了，早点休息吧。", "audio": "/audio/sentences/j8.mp3", "vocab": ["san1fu2", "jau1sik1"] },

  { "id": "w1", "scenarioId": "weather", "speaker": "A", "hanzi": "今日天氣好好呀。", "jyutping": "gam1 jat6 tin1 hei3 hou2 hou2 aa3", "mandarin": "今天天气真好。", "audio": "/audio/sentences/w1.mp3", "vocab": ["tin1hei3"] },
  { "id": "w2", "scenarioId": "weather", "speaker": "B", "hanzi": "係呀，出太陽喇。", "jyutping": "hai6 aa3 ceot1 taai3 joeng4 laa3", "mandarin": "是啊，出太阳了。", "audio": "/audio/sentences/w2.mp3", "vocab": ["taai3joeng4"] },
  { "id": "w3", "scenarioId": "weather", "speaker": "A", "hanzi": "聽日好似會落雨喎。", "jyutping": "ting1 jat6 hou2 ci5 wui5 lok6 jyu5 wo3", "mandarin": "明天好像会下雨哦。", "audio": "/audio/sentences/w3.mp3", "vocab": ["ting1jat6", "hou2ci5", "wui5", "lok6jyu5"] },
  { "id": "w4", "scenarioId": "weather", "speaker": "B", "hanzi": "咁記得帶遮啦。", "jyutping": "gam2 gei3 dak1 daai3 ze1 laa1", "mandarin": "那记得带伞啊。", "audio": "/audio/sentences/w4.mp3", "vocab": ["gei3dak1", "ze1"] },
  { "id": "w5", "scenarioId": "weather", "speaker": "A", "hanzi": "而家熱到死，飲杯凍嘢先。", "jyutping": "ji4 gaa1 jit6 dou3 sei2 jam2 bui1 dung3 je5 sin1", "mandarin": "现在热死了，先喝杯冷饮。", "audio": "/audio/sentences/w5.mp3", "vocab": ["ji4gaa1", "jam2", "bui1", "dung3je5", "sin1"] },
  { "id": "w6", "scenarioId": "weather", "speaker": "B", "hanzi": "夏天真係好焗。", "jyutping": "haa6 tin1 zan1 hai6 hou2 guk6", "mandarin": "夏天真的很闷热。", "audio": "/audio/sentences/w6.mp3", "vocab": ["guk6"] },
  { "id": "w7", "scenarioId": "weather", "speaker": "A", "hanzi": "冬天又凍，著多件衫啦。", "jyutping": "dung1 tin1 jau6 dung3 zoek3 do1 gin6 saam1 laa1", "mandarin": "冬天又冷，多穿件衣服吧。", "audio": "/audio/sentences/w7.mp3", "vocab": ["zoek3", "gin6", "saam1"] },
  { "id": "w8", "scenarioId": "weather", "speaker": "B", "hanzi": "香港嘅天氣真係難講。", "jyutping": "hoeng1 gong2 ge3 tin1 hei3 zan1 hai6 naan4 gong2", "mandarin": "香港的天气真的很难说。", "audio": "/audio/sentences/w8.mp3", "vocab": ["tin1hei3", "naan4gong2"] }
]
