[
  { "id": "greeting-01", "words": ["nei5-hou2", "ngo5", "giu3", "aa3-ming4"], "hanzi": "你好，我叫阿明。", "jyutping": "nei5 hou2, ngo5 giu3 aa3 ming4.", "mandarin": "你好，我叫阿明。", "audio": "/audio/sentences/greeting-01.mp3", "scenarioId": "greetings" },
  { "id": "greeting-02", "words": ["nei5-hou2", "aa3", "ngo5", "giu3", "siu2-jan1"], "hanzi": "你好呀，我叫小欣。", "jyutping": "nei5 hou2 aa3, ngo5 giu3 siu2 jan1.", "mandarin": "你好呀，我叫小欣。", "audio": "/audio/sentences/greeting-02.mp3", "scenarioId": "greetings" },
  { "id": "greeting-03", "words": ["nei5", "hai6-mai6", "hoeng1-gong2-jan4", "aa3"], "hanzi": "你係咪香港人呀？", "jyutping": "nei5 hai6 mai6 hoeng1 gong2 jan4 aa3?", "mandarin": "你是香港人吗？", "audio": "/audio/sentences/greeting-03.mp3", "scenarioId": "greetings" },
  { "id": "greeting-04", "words": ["m4-hai6", "ngo5", "ngaam1-ngaam1", "lai4", "hoeng1-gong2"], "hanzi": "唔係，我啱啱嚟香港。", "jyutping": "m4 hai6, ngo5 ngaam1 ngaam1 lai4 hoeng1 gong2.", "mandarin": "不是，我刚来香港。", "audio": "/audio/sentences/greeting-04.mp3", "scenarioId": "greetings" },
  { "id": "greeting-05", "words": ["nei5", "sik1-m4-sik1", "gong2", "gwong2-dung1-waa2", "aa3"], "hanzi": "你識唔識講廣東話呀？", "jyutping": "nei5 sik1 m4 sik1 gong2 gwong2 dung1 waa2 aa3?", "mandarin": "你会不会说粤语？", "audio": "/audio/sentences/greeting-05.mp3", "scenarioId": "greetings" },
  { "id": "greeting-06", "words": ["ngo5", "sik1", "gong2", "siu2-siu2", "zaa3"], "hanzi": "我識講少少咋。", "jyutping": "ngo5 sik1 gong2 siu2 siu2 zaa3.", "mandarin": "我只会说一点点。", "audio": "/audio/sentences/greeting-06.mp3", "scenarioId": "greetings" },
  { "id": "greeting-07", "words": ["nei5", "zyu6", "hai2", "bin1-dou6", "aa3"], "hanzi": "你住喺邊度呀？", "jyutping": "nei5 zyu6 hai2 bin1 dou6 aa3?", "mandarin": "你住在哪里？", "audio": "/audio/sentences/greeting-07.mp3", "scenarioId": "greetings" },
  { "id": "greeting-08", "words": ["ngo5", "zyu6", "hai2", "wong6-gok3", "go2-bin1"], "hanzi": "我住喺旺角嗰邊。", "jyutping": "ngo5 zyu6 hai2 wong6 gok3 go2 bin1.", "mandarin": "我住在旺角那边。", "audio": "/audio/sentences/greeting-08.mp3", "scenarioId": "greetings" },
  { "id": "greeting-09", "words": ["dak1-haan4", "jat1-cai4", "jam2-caa4", "aa1"], "hanzi": "得閒一齊飲茶吖。", "jyutping": "dak1 haan4 jat1 cai4 jam2 caa4 aa1.", "mandarin": "有空一起喝茶吧。", "audio": "/audio/sentences/greeting-09.mp3", "scenarioId": "greetings" },
  { "id": "greeting-10", "words": ["hou2", "aa3", "haa6-ci3", "gin3"], "hanzi": "好呀，下次見！", "jyutping": "hou2 aa3, haa6 ci3 gin3!", "mandarin": "好呀，下次见！", "audio": "/audio/sentences/greeting-10.mp3", "scenarioId": "greetings" },

  { "id": "cafe-01", "words": ["m4-goi1", "loeng5-wai2", "aa3"], "hanzi": "唔該，兩位呀。", "jyutping": "m4 goi1, loeng5 wai2 aa3.", "mandarin": "劳驾，两位。", "audio": "/audio/sentences/cafe-01.mp3", "scenarioId": "cha-chaan-teng" },
  { "id": "cafe-02", "words": ["ni1-bin1", "co5", "aa1"], "hanzi": "呢邊坐吖。", "jyutping": "ni1 bin1 co5 aa1.", "mandarin": "这边坐吧。", "audio": "/audio/sentences/cafe-02.mp3", "scenarioId": "cha-chaan-teng" },
  { "id": "cafe-03", "words": ["m4-goi1", "ngo5", "jiu3", "go3", "bo1-lo4-jau4"], "hanzi": "唔該，我要個菠蘿油。", "jyutping": "m4 goi1, ngo5 jiu3 go3 bo1 lo4 jau4.", "mandarin": "劳驾，我要一个菠萝油。", "audio": "/audio/sentences/cafe-03.mp3", "scenarioId": "cha-chaan-teng" },
  { "id": "cafe-04", "words": ["jam2", "di1", "mat1-je5", "aa3"], "hanzi": "飲啲乜嘢呀？", "jyutping": "jam2 di1 mat1 je5 aa3?", "mandarin": "喝点什么？", "audio": "/audio/sentences/cafe-04.mp3", "scenarioId": "cha-chaan-teng" },
  { "id": "cafe-05", "words": ["ngo5", "jiu3", "dung3-ning2-caa4", "siu2-tim4", "m4-goi1"], "hanzi": "我要凍檸茶，少甜唔該。", "jyutping": "ngo5 jiu3 dung3 ning2 caa4, siu2 tim4 m4 goi1.", "mandarin": "我要冻柠茶，少甜，谢谢。", "audio": "/audio/sentences/cafe-05.mp3", "scenarioId": "cha-chaan-teng" },
  { "id": "cafe-06", "words": ["zung6-jau5", "jat1-bui1", "jit6-naai5-caa4"], "hanzi": "仲有一杯熱奶茶。", "jyutping": "zung6 jau5 jat1 bui1 jit6 naai5 caa4.", "mandarin": "再来一杯热奶茶。", "audio": "/audio/sentences/cafe-06.mp3", "scenarioId": "cha-chaan-teng" },
  { "id": "cafe-07", "words": ["go3-caan1", "gan1-m4-gan1", "daan2", "gaa3"], "hanzi": "個餐跟唔跟蛋㗎？", "jyutping": "go3 caan1 gan1 m4 gan1 daan2 gaa3?", "mandarin": "这个套餐带不带鸡蛋？", "audio": "/audio/sentences/cafe-07.mp3", "scenarioId": "cha-chaan-teng" },
  { "id": "cafe-08", "words": ["gan1", "gaa3", "nei5", "jiu3", "caau2-daan2", "ding6", "taai3-joeng4-daan2"], "hanzi": "跟㗎，你要炒蛋定太陽蛋？", "jyutping": "gan1 gaa3, nei5 jiu3 caau2 daan2 ding6 taai3 joeng4 daan2?", "mandarin": "带的，你要炒蛋还是煎蛋？", "audio": "/audio/sentences/cafe-08.mp3", "scenarioId": "cha-chaan-teng" },
  { "id": "cafe-09", "words": ["caau2-daan2", "laa1", "m4-goi1-saai3"], "hanzi": "炒蛋啦，唔該晒。", "jyutping": "caau2 daan2 laa1, m4 goi1 saai3.", "mandarin": "炒蛋吧，多谢。", "audio": "/audio/sentences/cafe-09.mp3", "scenarioId": "cha-chaan-teng" },
  { "id": "cafe-10", "words": ["maai4-daan1", "aa3", "m4-goi1"], "hanzi": "埋單呀，唔該。", "jyutping": "maai4 daan1 aa3, m4 goi1.", "mandarin": "买单，谢谢。", "audio": "/audio/sentences/cafe-10.mp3", "scenarioId": "cha-chaan-teng" },

  { "id": "direction-01", "words": ["m4-hou2-ji3-si1", "cing2-man6", "dei6-tit3-zaam6", "hai2", "bin1", "aa3"], "hanzi": "唔好意思，請問地鐵站喺邊呀？", "jyutping": "m4 hou2 ji3 si1, cing2 man6 dei6 tit3 zaam6 hai2 bin1 aa3?", "mandarin": "不好意思，请问地铁站在哪里？", "audio": "/audio/sentences/direction-01.mp3", "scenarioId": "directions" },
  { "id": "direction-02", "words": ["nei5", "jat1-lou6", "zik6-haang4", "heoi3-dou3", "cin4-min6", "go3", "lou6-hau2"], "hanzi": "你一路直行，去到前面個路口。", "jyutping": "nei5 jat1 lou6 zik6 haang4, heoi3 dou3 cin4 min6 go3 lou6 hau2.", "mandarin": "你一直走，走到前面的路口。", "audio": "/audio/sentences/direction-02.mp3", "scenarioId": "directions" },
  { "id": "direction-03", "words": ["gan1-zyu6", "zyun2-zo2", "zau6", "gin3-dou2", "gaa3-laa3"], "hanzi": "跟住轉左就見到㗎喇。", "jyutping": "gan1 zyu6 zyun2 zo2 zau6 gin3 dou2 gaa3 laa3.", "mandarin": "然后左转就能看到了。", "audio": "/audio/sentences/direction-03.mp3", "scenarioId": "directions" },
  { "id": "direction-04", "words": ["haang4", "gwo3-heoi3", "jiu3", "gei2-noi6", "aa3"], "hanzi": "行過去要幾耐呀？", "jyutping": "haang4 gwo3 heoi3 jiu3 gei2 noi6 aa3?", "mandarin": "走过去要多久？", "audio": "/audio/sentences/direction-04.mp3", "scenarioId": "directions" },
  { "id": "direction-05", "words": ["daai6-koi3", "ng5-fan1-zung1", "laa1"], "hanzi": "大概五分鐘啦。", "jyutping": "daai6 koi3 ng5 fan1 zung1 laa1.", "mandarin": "大概五分钟。", "audio": "/audio/sentences/direction-05.mp3", "scenarioId": "directions" },
  { "id": "direction-06", "words": ["sai2-m4-sai2", "gwo3", "maa5-lou6", "aa3"], "hanzi": "使唔使過馬路呀？", "jyutping": "sai2 m4 sai2 gwo3 maa5 lou6 aa3?", "mandarin": "要不要过马路？", "audio": "/audio/sentences/direction-06.mp3", "scenarioId": "directions" },
  { "id": "direction-07", "words": ["jiu3", "aa3", "gwo3-zo2", "dang1-wai2", "zoi3", "zyun2-jau6"], "hanzi": "要呀，過咗燈位再轉右。", "jyutping": "jiu3 aa3, gwo3 zo2 dang1 wai2 zoi3 zyun2 jau6.", "mandarin": "要，过了红绿灯再右转。", "audio": "/audio/sentences/direction-07.mp3", "scenarioId": "directions" },
  { "id": "direction-08", "words": ["go2-bin1", "hai6-mai6", "jau5", "gaan1", "bin6-lei6-dim3"], "hanzi": "嗰邊係咪有間便利店？", "jyutping": "go2 bin1 hai6 mai6 jau5 gaan1 bin6 lei6 dim3?", "mandarin": "那边是不是有一家便利店？", "audio": "/audio/sentences/direction-08.mp3", "scenarioId": "directions" },
  { "id": "direction-09", "words": ["hai6", "aa3", "dei6-tit3-zaam6", "zau6", "hai2", "gaak3-lei4"], "hanzi": "係呀，地鐵站就喺隔籬。", "jyutping": "hai6 aa3, dei6 tit3 zaam6 zau6 hai2 gaak3 lei4.", "mandarin": "对，地铁站就在旁边。", "audio": "/audio/sentences/direction-09.mp3", "scenarioId": "directions" },
  { "id": "direction-10", "words": ["ming4-baak6", "m4-goi1-saai3", "nei5"], "hanzi": "明白，唔該晒你！", "jyutping": "ming4 baak6, m4 goi1 saai3 nei5!", "mandarin": "明白了，太谢谢你了！", "audio": "/audio/sentences/direction-10.mp3", "scenarioId": "directions" },

  { "id": "shopping-01", "words": ["ni1-gin6-saam1", "jau5-mou5", "daai6", "jat1-go3", "maa5", "aa3"], "hanzi": "呢件衫有冇大一個碼呀？", "jyutping": "ni1 gin6 saam1 jau5 mou5 daai6 jat1 go3 maa5 aa3?", "mandarin": "这件衣服有没有大一码？", "audio": "/audio/sentences/shopping-01.mp3", "scenarioId": "shopping" },
  { "id": "shopping-02", "words": ["jau5", "aa3", "ngo5", "lo2", "bei2", "nei5", "si3", "aa1"], "hanzi": "有呀，我攞畀你試吖。", "jyutping": "jau5 aa3, ngo5 lo2 bei2 nei5 si3 aa1.", "mandarin": "有，我拿给你试试。", "audio": "/audio/sentences/shopping-02.mp3", "scenarioId": "shopping" },
  { "id": "shopping-03", "words": ["si3-san1-sat1", "hai2", "bin1-dou6", "aa3"], "hanzi": "試身室喺邊度呀？", "jyutping": "si3 san1 sat1 hai2 bin1 dou6 aa3?", "mandarin": "试衣间在哪里？", "audio": "/audio/sentences/shopping-03.mp3", "scenarioId": "shopping" },
  { "id": "shopping-04", "words": ["hai2", "cin4-min6", "zyun2-zo2", "zau6-hai6", "laa3"], "hanzi": "喺前面轉左就係喇。", "jyutping": "hai2 cin4 min6 zyun2 zo2 zau6 hai6 laa3.", "mandarin": "在前面左转就是了。", "audio": "/audio/sentences/shopping-04.mp3", "scenarioId": "shopping" },
  { "id": "shopping-05", "words": ["ni1-gin6", "zoek3-dak1", "gei2", "syu1-fuk6", "wo3"], "hanzi": "呢件着得幾舒服喎。", "jyutping": "ni1 gin6 zoek3 dak1 gei2 syu1 fuk6 wo3.", "mandarin": "这件穿着挺舒服的。", "audio": "/audio/sentences/shopping-05.mp3", "scenarioId": "shopping" },
  { "id": "shopping-06", "words": ["daan6-hai6", "zek3-sik1", "jau5-di1", "sam1"], "hanzi": "但係隻色有啲深。", "jyutping": "daan6 hai6 zek3 sik1 jau5 di1 sam1.", "mandarin": "但是颜色有点深。", "audio": "/audio/sentences/shopping-06.mp3", "scenarioId": "shopping" },
  { "id": "shopping-07", "words": ["jau5-mou5", "cin2-sik1", "di1", "gaa3"], "hanzi": "有冇淺色啲㗎？", "jyutping": "jau5 mou5 cin2 sik1 di1 gaa3?", "mandarin": "有没有浅一点的颜色？", "audio": "/audio/sentences/shopping-07.mp3", "scenarioId": "shopping" },
  { "id": "shopping-08", "words": ["ni1-gin6", "zeoi3-peng4", "gei2-cin2", "aa3"], "hanzi": "呢件最平幾錢呀？", "jyutping": "ni1 gin6 zeoi3 peng4 gei2 cin2 aa3?", "mandarin": "这件最低多少钱？", "audio": "/audio/sentences/shopping-08.mp3", "scenarioId": "shopping" },
  { "id": "shopping-09", "words": ["nei5", "maai5", "loeng5-gin6", "ngo5", "peng4-di1", "bei2", "nei5", "laa1"], "hanzi": "你買兩件，我平啲畀你啦。", "jyutping": "nei5 maai5 loeng5 gin6, ngo5 peng4 di1 bei2 nei5 laa1.", "mandarin": "你买两件，我给你便宜点。", "audio": "/audio/sentences/shopping-09.mp3", "scenarioId": "shopping" },
  { "id": "shopping-10", "words": ["hou2", "laa1", "ngo5", "jiu3", "ni1", "loeng5-gin6"], "hanzi": "好啦，我要呢兩件。", "jyutping": "hou2 laa1, ngo5 jiu3 ni1 loeng5 gin6.", "mandarin": "好吧，我要这两件。", "audio": "/audio/sentences/shopping-10.mp3", "scenarioId": "shopping" },

  { "id": "mtr-01", "words": ["m4-goi1", "heoi3", "zung1-waan4", "jiu3", "daap3", "bin1-tiu4-sin3", "aa3"], "hanzi": "唔該，去中環要搭邊條線呀？", "jyutping": "m4 goi1, heoi3 zung1 waan4 jiu3 daap3 bin1 tiu4 sin3 aa3?", "mandarin": "请问，去中环要坐哪条线？", "audio": "/audio/sentences/mtr-01.mp3", "scenarioId": "mtr" },
  { "id": "mtr-02", "words": ["daap3", "cyun4-waan1-sin3", "m4-sai2", "zyun2-ce1"], "hanzi": "搭荃灣線，唔使轉車。", "jyutping": "daap3 cyun4 waan1 sin3, m4 sai2 zyun2 ce1.", "mandarin": "坐荃湾线，不用换乘。", "audio": "/audio/sentences/mtr-02.mp3", "scenarioId": "mtr" },
  { "id": "mtr-03", "words": ["ngo5", "jiu3", "heoi3", "bin1-go3", "jyut6-toi4", "aa3"], "hanzi": "我要去邊個月台呀？", "jyutping": "ngo5 jiu3 heoi3 bin1 go3 jyut6 toi4 aa3?", "mandarin": "我要去哪个站台？", "audio": "/audio/sentences/mtr-03.mp3", "scenarioId": "mtr" },
  { "id": "mtr-04", "words": ["heoi3", "deoi3-min6", "go2-go3", "jyut6-toi4"], "hanzi": "去對面嗰個月台。", "jyutping": "heoi3 deoi3 min6 go2 go3 jyut6 toi4.", "mandarin": "去对面那个站台。", "audio": "/audio/sentences/mtr-04.mp3", "scenarioId": "mtr" },
  { "id": "mtr-05", "words": ["ni1-baan1-ce1", "heoi3-m4-heoi3", "zung1-waan4", "gaa3"], "hanzi": "呢班車去唔去中環㗎？", "jyutping": "ni1 baan1 ce1 heoi3 m4 heoi3 zung1 waan4 gaa3?", "mandarin": "这班车去不去中环？", "audio": "/audio/sentences/mtr-05.mp3", "scenarioId": "mtr" },
  { "id": "mtr-06", "words": ["heoi3", "gaa3", "saam1-go3-zaam6", "zau6", "dou3"], "hanzi": "去㗎，三個站就到。", "jyutping": "heoi3 gaa3, saam1 go3 zaam6 zau6 dou3.", "mandarin": "去，三站就到。", "audio": "/audio/sentences/mtr-06.mp3", "scenarioId": "mtr" },
  { "id": "mtr-07", "words": ["haa6-jat1-zaam6", "hai6", "gam1-zung1"], "hanzi": "下一站係金鐘。", "jyutping": "haa6 jat1 zaam6 hai6 gam1 zung1.", "mandarin": "下一站是金钟。", "audio": "/audio/sentences/mtr-07.mp3", "scenarioId": "mtr" },
  { "id": "mtr-08", "words": ["heoi3-dou3", "gam1-zung1", "wui5", "jau5", "hou2-do1-jan4", "lok6-ce1", "gaa3"], "hanzi": "去到金鐘會有好多人落車㗎。", "jyutping": "heoi3 dou3 gam1 zung1 wui5 jau5 hou2 do1 jan4 lok6 ce1 gaa3.", "mandarin": "到金钟会有很多人下车。", "audio": "/audio/sentences/mtr-08.mp3", "scenarioId": "mtr" },
  { "id": "mtr-09", "words": ["siu2-sam1", "di1", "m4-hou2", "kei5", "gan6", "ce1-mun4"], "hanzi": "小心啲，唔好企近車門。", "jyutping": "siu2 sam1 di1, m4 hou2 kei5 gan6 ce1 mun4.", "mandarin": "小心点，不要站近车门。", "audio": "/audio/sentences/mtr-09.mp3", "scenarioId": "mtr" },
  { "id": "mtr-10", "words": ["dou3-zo2", "laa3", "ngo5-dei6", "hai2", "ni1-dou6", "lok6"], "hanzi": "到咗喇，我哋喺呢度落。", "jyutping": "dou3 zo2 laa3, ngo5 dei6 hai2 ni1 dou6 lok6.", "mandarin": "到了，我们在这里下车。", "audio": "/audio/sentences/mtr-10.mp3", "scenarioId": "mtr" },

  { "id": "phone-01", "words": ["wai2", "hai6-mai6", "aa3-jan1", "aa3"], "hanzi": "喂，係咪阿欣呀？", "jyutping": "wai2, hai6 mai6 aa3 jan1 aa3?", "mandarin": "喂，是阿欣吗？", "audio": "/audio/sentences/phone-01.mp3", "scenarioId": "phone" },
  { "id": "phone-02", "words": ["hai6", "aa3", "nei5", "bin1-wai2", "aa3"], "hanzi": "係呀，你邊位呀？", "jyutping": "hai6 aa3, nei5 bin1 wai2 aa3?", "mandarin": "是，你是哪位？", "audio": "/audio/sentences/phone-02.mp3", "scenarioId": "phone" },
  { "id": "phone-03", "words": ["ngo5", "hai6", "aa3-ming4", "aa3", "nei5", "ji4-gaa1", "dak1-m4-dak1-haan4"], "hanzi": "我係阿明呀，你而家得唔得閒？", "jyutping": "ngo5 hai6 aa3 ming4 aa3, nei5 ji4 gaa1 dak1 m4 dak1 haan4?", "mandarin": "我是阿明，你现在有空吗？", "audio": "/audio/sentences/phone-03.mp3", "scenarioId": "phone" },
  { "id": "phone-04", "words": ["dak1", "aa3", "me1-si6", "aa3"], "hanzi": "得呀，咩事呀？", "jyutping": "dak1 aa3, me1 si6 aa3?", "mandarin": "有空，什么事？", "audio": "/audio/sentences/phone-04.mp3", "scenarioId": "phone" },
  { "id": "phone-05", "words": ["ngo5", "soeng2", "man6", "nei5", "ting1-jat6", "heoi3-m4-heoi3", "haang4-gaai1", "aa3"], "hanzi": "我想問你聽日去唔去行街呀。", "jyutping": "ngo5 soeng2 man6 nei5 ting1 jat6 heoi3 m4 heoi3 haang4 gaai1 aa3.", "mandarin": "我想问你明天去不去逛街。", "audio": "/audio/sentences/phone-05.mp3", "scenarioId": "phone" },
  { "id": "phone-06", "words": ["heoi3", "aa3", "gei2-dim2", "gin3", "aa3"], "hanzi": "去呀，幾點見呀？", "jyutping": "heoi3 aa3, gei2 dim2 gin3 aa3?", "mandarin": "去，几点见？", "audio": "/audio/sentences/phone-06.mp3", "scenarioId": "phone" },
  { "id": "phone-07", "words": ["haa6-zau3", "saam1-dim2", "hai2", "wong6-gok3", "dei6-tit3-zaam6", "gin3", "laa1"], "hanzi": "下晝三點，喺旺角地鐵站見啦。", "jyutping": "haa6 zau3 saam1 dim2, hai2 wong6 gok3 dei6 tit3 zaam6 gin3 laa1.", "mandarin": "下午三点，在旺角地铁站见吧。", "audio": "/audio/sentences/phone-07.mp3", "scenarioId": "phone" },
  { "id": "phone-08", "words": ["hou2", "aa3", "dou3-si4", "daa2", "bei2", "ngo5", "laa1"], "hanzi": "好呀，到時打畀我啦。", "jyutping": "hou2 aa3, dou3 si4 daa2 bei2 ngo5 laa1.", "mandarin": "好，到时候打给我。", "audio": "/audio/sentences/phone-08.mp3", "scenarioId": "phone" },
  { "id": "phone-09", "words": ["jyu4-gwo2", "ngo5", "ci4-dou3", "zau6", "waa6", "nei5", "zi1"], "hanzi": "如果我遲到就話你知。", "jyutping": "jyu4 gwo2 ngo5 ci4 dou3 zau6 waa6 nei5 zi1.", "mandarin": "如果我迟到就告诉你。", "audio": "/audio/sentences/phone-09.mp3", "scenarioId": "phone" },
  { "id": "phone-10", "words": ["dak1", "ting1-jat6", "gin3", "baai1-baai3"], "hanzi": "得，聽日見，拜拜！", "jyutping": "dak1, ting1 jat6 gin3, baai1 baai3!", "mandarin": "好，明天见，拜拜！", "audio": "/audio/sentences/phone-10.mp3", "scenarioId": "phone" }
