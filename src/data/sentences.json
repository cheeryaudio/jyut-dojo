[
  { "id": "g1", "scenarioId": "greet", "speaker": "A", "hanzi": "你好呀！", "jyutping": "nei5 hou2 aa3", "mandarin": "你好呀！", "audio": "/audio/sentences/g1.mp3", "vocab": ["nei5hou2"] },
  { "id": "g2", "scenarioId": "greet", "speaker": "A", "hanzi": "早晨！食咗飯未呀？", "jyutping": "zou2 san4 sik6 zo2 faan6 mei6 aa3", "mandarin": "早上好！吃过饭了没有？", "audio": "/audio/sentences/g2.mp3", "vocab": ["zou2san4", "sik6", "faan6", "mei6"] },
  { "id": "g3", "scenarioId": "greet", "speaker": "A", "hanzi": "我叫阿明，你叫咩名呀？", "jyutping": "ngo5 giu3 aa3 ming4 nei5 giu3 me1 meng2 aa3", "mandarin": "我叫阿明，你叫什么名字？", "audio": "/audio/sentences/g3.mp3", "vocab": ["giu3", "me1", "meng2"] },
  { "id": "g4", "scenarioId": "greet", "speaker": "B", "hanzi": "好耐冇見喇！", "jyutping": "hou2 noi6 mou5 gin3 laa3", "mandarin": "好久不见了！", "audio": "/audio/sentences/g4.mp3", "vocab": ["hou2noi6", "mou5", "gin3"] },
  { "id": "g5", "scenarioId": "greet", "speaker": "A", "hanzi": "你最近點呀？", "jyutping": "nei5 zeoi3 gan6 dim2 aa3", "mandarin": "你最近怎么样？", "audio": "/audio/sentences/g5.mp3", "vocab": ["zeoi3gan6", "dim2"] },
  { "id": "g6", "scenarioId": "greet", "speaker": "B", "hanzi": "幾好呀，你呢？", "jyutping": "gei2 hou2 aa3 nei5 ne1", "mandarin": "挺好的，你呢？", "audio": "/audio/sentences/g6.mp3", "vocab": ["gei2hou2"] },
  { "id": "g7", "scenarioId": "greet", "speaker": "A", "hanzi": "唔該晒你呀！", "jyutping": "m4 goi1 saai3 nei5 aa3", "mandarin": "太谢谢你了！", "audio": "/audio/sentences/g7.mp3", "vocab": ["m4goi1saai3"] },
  { "id": "g8", "scenarioId": "greet", "speaker": "B", "hanzi": "遲啲見啦，拜拜！", "jyutping": "ci4 di1 gin3 laa1 baai1 baai3", "mandarin": "回头见，拜拜！", "audio": "/audio/sentences/g8.mp3", "vocab": ["ci4di1", "gin3", "baai1baai3"] },

  { "id": "c1", "scenarioId": "cafe", "speaker": "A", "hanzi": "唔該，有冇位呀？", "jyutping": "m4 goi1 jau5 mou5 wai2 aa3", "mandarin": "劳驾，有位子吗？", "audio": "/audio/sentences/c1.mp3", "vocab": ["m4goi1", "jau5mou5", "wai2"] },
  { "id": "c2", "scenarioId": "cafe", "speaker": "B", "hanzi": "幾多位呀？", "jyutping": "gei2 do1 wai2 aa3", "mandarin": "几位？", "audio": "/audio/sentences/c2.mp3", "vocab": ["gei2do1", "wai2"] },
  { "id": "c3", "scenarioId": "cafe", "speaker": "A", "hanzi": "兩位，唔該。", "jyutping": "loeng5 wai2 m4 goi1", "mandarin": "两位，谢谢。", "audio": "/audio/sentences/c3.mp3", "vocab": ["loeng5", "wai2", "m4goi1"] },
  { "id": "c4", "scenarioId": "cafe", "speaker": "A", "hanzi": "唔該畀個餐牌我。", "jyutping": "m4 goi1 bei2 go3 caan1 paai2 ngo5", "mandarin": "麻烦给我一份菜单。", "audio": "/audio/sentences/c4.mp3", "vocab": ["bei2", "caan1paai2"] },
  { "id": "c5", "scenarioId": "cafe", "speaker": "A", "hanzi": "我要一個菠蘿油同凍檸茶。", "jyutping": "ngo5 jiu3 jat1 go3 bo1 lo4 jau4 tung4 dung3 ning2 caa4", "mandarin": "我要一个菠萝油和冻柠檬茶。", "audio": "/audio/sentences/c5.mp3", "vocab": ["jiu3", "bo1lo4jau4", "tung4", "dung3ning2caa4"] },
  { "id": "c6", "scenarioId": "cafe", "speaker": "A", "hanzi": "凍檸茶走冰，唔該。", "jyutping": "dung3 ning2 caa4 zau2 bing1 m4 goi1", "mandarin": "冻柠茶去冰，谢谢。", "audio": "/audio/sentences/c6.mp3", "vocab": ["dung3ning2caa4", "zau2bing1"] },
  { "id": "c7", "scenarioId": "cafe", "speaker": "B", "hanzi": "呢度食定攞走呀？", "jyutping": "ni1 dou6 sik6 ding6 lo2 zau2 aa3", "mandarin": "在这儿吃还是带走？", "audio": "/audio/sentences/c7.mp3", "vocab": ["ni1dou6", "sik6", "ding6", "lo2zau2"] },
  { "id": "c8", "scenarioId": "cafe", "speaker": "A", "hanzi": "唔該，埋單！", "jyutping": "m4 goi1 maai4 daan1", "mandarin": "劳驾，买单！", "audio": "/audio/sentences/c8.mp3", "vocab": ["m4goi1", "maai4daan1"] },

  { "id": "d1", "scenarioId": "direction", "speaker": "A", "hanzi": "唔好意思，想問下路。", "jyutping": "m4 hou2 ji3 si1 soeng2 man6 haa5 lou6", "mandarin": "不好意思，想问一下路。", "audio": "/audio/sentences/d1.mp3", "vocab": ["m4hou2ji3si1", "man6", "lou6"] },
  { "id": "d2", "scenarioId": "direction", "speaker": "A", "hanzi": "請問地鐵站喺邊度呀？", "jyutping": "cing2 man6 dei6 tit3 zaam6 hai2 bin1 dou6 aa3", "mandarin": "请问地铁站在哪里？", "audio": "/audio/sentences/d2.mp3", "vocab": ["cing2man6", "dei6tit3zaam6", "hai2", "bin1dou6"] },
  { "id": "d3", "scenarioId": "direction", "speaker": "B", "hanzi": "一直行，去到前面轉左。", "jyutping": "jat1 zik6 haang4 heoi3 dou3 cin4 min6 zyun3 zo2", "mandarin": "一直走，走到前面左转。", "audio": "/audio/sentences/d3.mp3", "vocab": ["jat1zik6", "haang4", "zyun3zo2"] },
  { "id": "d4", "scenarioId": "direction", "speaker": "A", "hanzi": "行幾耐呀？", "jyutping": "haang4 gei2 noi6 aa3", "mandarin": "要走多久？", "audio": "/audio/sentences/d4.mp3", "vocab": ["haang4", "gei2noi6"] },
  { "id": "d5", "scenarioId": "direction", "speaker": "B", "hanzi": "大概五分鐘啦。", "jyutping": "daai6 koi3 ng5 fan1 zung1 laa1", "mandarin": "大概五分钟吧。", "audio": "/audio/sentences/d5.mp3", "vocab": ["daai6koi3", "fan1zung1"] },
  { "id": "d6", "scenarioId": "direction", "speaker": "B", "hanzi": "過咗馬路就見到㗎喇。", "jyutping": "gwo3 zo2 maa5 lou6 zau6 gin3 dou2 gaa3 laa3", "mandarin": "过了马路就能看见了。", "audio": "/audio/sentences/d6.mp3", "vocab": ["maa5lou6", "gin3dou2"] },
  { "id": "d7", "scenarioId": "direction", "speaker": "A", "hanzi": "明白喇，唔該晒！", "jyutping": "ming4 baak6 laa3 m4 goi1 saai3", "mandarin": "明白了，多谢！", "audio": "/audio/sentences/d7.mp3", "vocab": ["ming4baak6", "m4goi1saai3"] },
  { "id": "d8", "scenarioId": "direction", "speaker": "B", "hanzi": "唔使客氣。", "jyutping": "m4 sai2 haak3 hei3", "mandarin": "不用客气。", "audio": "/audio/sentences/d8.mp3", "vocab": ["m4sai2", "haak3hei3"] },

  { "id": "s1", "scenarioId": "shopping", "speaker": "A", "hanzi": "呢件衫幾多錢呀？", "jyutping": "ni1 gin6 saam1 gei2 do1 cin2 aa3", "mandarin": "这件衣服多少钱？", "audio": "/audio/sentences/s1.mp3", "vocab": ["ni1", "gin6", "saam1", "gei2do1", "cin2"] },
  { "id": "s2", "scenarioId": "shopping", "speaker": "B", "hanzi": "一百二十蚊。", "jyutping": "jat1 baak3 ji6 sap6 man1", "mandarin": "一百二十块。", "audio": "/audio/sentences/s2.mp3", "vocab": ["man1"] },
  { "id": "s3", "scenarioId": "shopping", "speaker": "A", "hanzi": "咁貴嘅？平啲得唔得呀？", "jyutping": "gam3 gwai3 ge2 peng4 di1 dak1 m4 dak1 aa3", "mandarin": "这么贵？便宜点行不行？", "audio": "/audio/sentences/s3.mp3", "vocab": ["gam3", "gwai3", "peng4", "di1", "dak1"] },
  { "id": "s4", "scenarioId": "shopping", "speaker": "B", "hanzi": "最平一百蚊喇。", "jyutping": "zeoi3 peng4 jat1 baak3 man1 laa3", "mandarin": "最便宜一百块了。", "audio": "/audio/sentences/s4.mp3", "vocab": ["peng4", "man1"] },
  { "id": "s5", "scenarioId": "shopping", "speaker": "A", "hanzi": "有冇第二個色呀？", "jyutping": "jau5 mou5 dai6 ji6 go3 sik1 aa3", "mandarin": "有没有别的颜色？", "audio": "/audio/sentences/s5.mp3", "vocab": ["jau5mou5", "sik1"] },
  { "id": "s6", "scenarioId": "shopping", "speaker": "A", "hanzi": "可唔可以試下呀？", "jyutping": "ho2 m4 ho2 ji5 si3 haa5 aa3", "mandarin": "可不可以试一下？", "audio": "/audio/sentences/s6.mp3", "vocab": ["si3haa5"] },
  { "id": "s7", "scenarioId": "shopping", "speaker": "A", "hanzi": "好啦，我要呢件。", "jyutping": "hou2 laa1 ngo5 jiu3 ni1 gin6", "mandarin": "好吧，我要这件。", "audio": "/audio/sentences/s7.mp3", "vocab": ["jiu3", "ni1", "gin6"] },
  { "id": "s8", "scenarioId": "shopping", "speaker": "B", "hanzi": "多謝晒！歡迎下次再嚟。", "jyutping": "do1 ze6 saai3 fun1 jing4 haa6 ci3 zoi3 lai4", "mandarin": "多谢！欢迎下次再来。", "audio": "/audio/sentences/s8.mp3", "vocab": ["do1ze6", "lai4"] },

  { "id": "m1", "scenarioId": "mtr", "speaker": "A", "hanzi": "唔該，我想買一張八達通。", "jyutping": "m4 goi1 ngo5 soeng2 maai5 jat1 zoeng1 baat3 daat6 tung1", "mandarin": "劳驾，我想买一张八达通。", "audio": "/audio/sentences/m1.mp3", "vocab": ["maai5", "baat3daat6tung1"] },
  { "id": "m2", "scenarioId": "mtr", "speaker": "A", "hanzi": "去中環要喺邊度轉車呀？", "jyutping": "heoi3 zung1 waan4 jiu3 hai2 bin1 dou6 zyun3 ce1 aa3", "mandarin": "去中环要在哪里换乘？", "audio": "/audio/sentences/m2.mp3", "vocab": ["heoi3", "hai2", "bin1dou6", "zyun3ce1"] },
  { "id": "m3", "scenarioId": "mtr", "speaker": "B", "hanzi": "喺金鐘轉港島綫。", "jyutping": "hai2 gam1 zung1 zyun3 gong2 dou2 sin3", "mandarin": "在金钟换港岛线。", "audio": "/audio/sentences/m3.mp3", "vocab": ["hai2", "zyun3ce1", "gong2dou2sin3"] },
  { "id": "m4", "scenarioId": "mtr", "speaker": "A", "hanzi": "呢班車去唔去尖沙咀㗎？", "jyutping": "ni1 baan1 ce1 heoi3 m4 heoi3 zim1 saa1 zeoi2 gaa3", "mandarin": "这班车去不去尖沙咀？", "audio": "/audio/sentences/m4.mp3", "vocab": ["baan1", "heoi3"] },
  { "id": "m5", "scenarioId": "mtr", "speaker": "B", "hanzi": "仲有一個站就到喇。", "jyutping": "zung6 jau5 jat1 go3 zaam6 zau6 dou3 laa3", "mandarin": "还有一站就到了。", "audio": "/audio/sentences/m5.mp3", "vocab": ["zung6", "zaam6"] },
  { "id": "m6", "scenarioId": "mtr", "speaker": "B", "hanzi": "而家好多人，等下一班啦。", "jyutping": "ji4 gaa1 hou2 do1 jan4 dang2 haa6 jat1 baan1 laa1", "mandarin": "现在人很多，等下一班吧。", "audio": "/audio/sentences/m6.mp3", "vocab": ["ji4gaa1", "jan4", "dang2", "baan1"] },
  { "id": "m7", "scenarioId": "mtr", "speaker": "A", "hanzi": "唔該借借！", "jyutping": "m4 goi1 ze3 ze3", "mandarin": "劳驾借过！", "audio": "/audio/sentences/m7.mp3", "vocab": ["m4goi1", "ze3ze3"] },
  { "id": "m8", "scenarioId": "mtr", "speaker": "B", "hanzi": "到站喇，快啲落車啦。", "jyutping": "dou3 zaam6 laa3 faai3 di1 lok6 ce1 laa1", "mandarin": "到站了，快点下车吧。", "audio": "/audio/sentences/m8.mp3", "vocab": ["zaam6", "faai3di1", "lok6ce1"] },

  { "id": "p1", "scenarioId": "phone", "speaker": "B", "hanzi": "喂，你好，搵邊位呀？", "jyutping": "wai2 nei5 hou2 wan2 bin1 wai2 aa3", "mandarin": "喂，你好，找哪位？", "audio": "/audio/sentences/p1.mp3", "vocab": ["wai2wei", "wan2"] },
  { "id": "p2", "scenarioId": "phone", "speaker": "A", "hanzi": "你好，我想搵陳生。", "jyutping": "nei5 hou2 ngo5 soeng2 wan2 can4 saang1", "mandarin": "你好，我想找陈先生。", "audio": "/audio/sentences/p2.mp3", "vocab": ["wan2", "can4saang1"] },
  { "id": "p3", "scenarioId": "phone", "speaker": "B", "hanzi": "佢而家唔喺度喎。", "jyutping": "keoi5 ji4 gaa1 m4 hai2 dou6 wo3", "mandarin": "他现在不在哦。", "audio": "/audio/sentences/p3.mp3", "vocab": ["keoi5", "ji4gaa1", "hai2dou6"] },
  { "id": "p4", "scenarioId": "phone", "speaker": "A", "hanzi": "你聽日得唔得閒呀？", "jyutping": "nei5 ting1 jat6 dak1 m4 dak1 haan4 aa3", "mandarin": "你明天有没有空？", "audio": "/audio/sentences/p4.mp3", "vocab": ["ting1jat6", "dak1haan4"] },
  { "id": "p5", "scenarioId": "phone", "speaker": "A", "hanzi": "我哋一齊食晏啦。", "jyutping": "ngo5 dei6 jat1 cai4 sik6 aan3 laa1", "mandarin": "我们一起吃午饭吧。", "audio": "/audio/sentences/p5.mp3", "vocab": ["ngo5dei6", "jat1cai4", "sik6aan3"] },
  { "id": "p6", "scenarioId": "phone", "speaker": "B", "hanzi": "好呀，幾點見呀？", "jyutping": "hou2 aa3 gei2 dim2 gin3 aa3", "mandarin": "好啊，几点见？", "audio": "/audio/sentences/p6.mp3", "vocab": ["gei2dim2", "gin3"] },
  { "id": "p7", "scenarioId": "phone", "speaker": "A", "hanzi": "下晝一點，喺旺角見啦。", "jyutping": "haa6 zau3 jat1 dim2 hai2 wong6 gok3 gin3 laa1", "mandarin": "下午一点，在旺角见吧。", "audio": "/audio/sentences/p7.mp3", "vocab": ["haa6zau3", "wong6gok3", "gin3"] },
  { "id": "p8", "scenarioId": "phone", "speaker": "B", "hanzi": "好呀，聽日見！", "jyutping": "hou2 aa3 ting1 jat6 gin3", "mandarin": "好啊，明天见！", "audio": "/audio/sentences/p8.mp3", "vocab": ["ting1jat6", "gin3"] }
]
