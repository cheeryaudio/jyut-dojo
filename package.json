{
  "name": "jyut-dojo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "validate:data": "node scripts/validate-content.mjs",
    "test": "node scripts/validate-content.mjs && vitest run",
    "test:watch": "vitest",
    "check": "npm test && npm run build",
    "validate": "npm run validate:data",
    "audio:generate": "node scripts/gen-audio.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:test": "cd android && gradlew.bat :app:testDebugUnitTest :app:assembleDebugAndroidTest",
    "android:lint": "cd android && gradlew.bat :app:lintDebug",
    "android:bundle": "npm run android:sync && cd android && gradlew.bat bundleRelease",
    "android:release-apk": "npm run android:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@phosphor-icons/react": "^2.1.10",
    "localforage": "^1.10.0",
    "msedge-tts": "^2.0.7",
    "pitchy": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
